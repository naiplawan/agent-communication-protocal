# ACP Relay — Dockerfile for cloud deployment
#
# Build:
#   docker build -f Dockerfile.relay -t acp-relay .
#
# Run:
#   docker run -d \
#     --name acp-relay \
#     -p 8443:8443 \
#     -e ACP_SHARED_SECRET=your_secret \
#     -e ACP_DB_PATH=/data/acp-messages.db \
#     -e ACP_PORT=8443 \
#     -v acp-relay-data:/data \
#     --restart unless-stopped \
#     acp-relay

# ── Stage 1: Build ────────────────────────────────────────────────────────────
# Pinned to bookworm to match the runtime stage below: the floating
# `rust:1.93-slim` tag now resolves to Debian 13 (trixie), whose OpenSSL 3.5 and
# glibc 2.41 the bookworm runtime does not have.
FROM rust:1.93-slim-bookworm AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config libssl-dev && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Create a temporary crate so dependency compilation can be cached in the
# image layers even when using Docker's legacy builder.
RUN cargo new relay

COPY relay-server/Cargo.toml ./relay/
WORKDIR /build/relay

# Pre-compile deps
RUN cargo build --release

# Rebuild just our crate
COPY relay-server/src ./src/
RUN cargo build --release

# ── Stage 2: Runtime ──────────────────────────────────────────────────────────
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    wget \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

# No extra user — run as root inside container (network namespace is isolated)
RUN useradd --create-home --shell /bin/bash relay && \
    mkdir -p /data && chown relay:relay /data

COPY --from=builder /build/relay/target/release/acp-relay /usr/local/bin/acp-relay

ENV RUST_LOG=info \
    ACP_DB_PATH=/data/acp-messages.db \
    ACP_PORT=8443

EXPOSE 8443

# Store data on a volume
VOLUME ["/data"]

# Run as non-root user inside the container
USER relay

CMD ["acp-relay"]
