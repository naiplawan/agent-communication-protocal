# Relay address on the other laptop's Wi-Fi network.
ACP_RELAY_URL=http://192.168.1.36:8443

ACP_AGENT_ID=naiplawan-agent
ACP_MACHINE_ID=naiplawan-machine
ACP_HTTP_ENDPOINT=http://SECOND_LAPTOP_IP:8444
ACP_POLL_INTERVAL=3
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731

# Copy the shared ACP secret and your model key into .env.remote-agent.
ACP_SHARED_SECRET=replace-with-the-relay-shared-secret
OPENROUTER_API_KEY=replace-with-your-openrouter-key
